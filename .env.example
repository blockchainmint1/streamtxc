# ---------------------------------------------------------------------------
# IPFS gateway configuration
# ---------------------------------------------------------------------------
# Comma-separated, ordered list of IPFS HTTP gateways. The backend tries
# them in order with automatic fallback for /api/stream/<cid> and the
# Add-by-CID probe.
#
# Production / hosted gateway preference:
IPFS_GATEWAY_URLS=https://ipfs.blockchainmint.com,https://gateway.pinata.cloud,https://ipfs.io

# Local development only, with fallback. Localhost IPFS gateways should
# only be used when the backend is running on the same machine as the
# IPFS node. Do NOT rely on localhost gateways in production or
# Lovable-hosted deployments — the deployed Worker cannot reach your
# laptop's 127.0.0.1.
# IPFS_GATEWAY_URLS=http://127.0.0.1:8080,https://ipfs.blockchainmint.com,https://gateway.pinata.cloud

# Pinata pinning (kept as the durable backing pin store)
# PINATA_JWT=
# PINATA_GATEWAY_DOMAIN=